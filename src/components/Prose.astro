---
---
<div class="prose">
  <slot />
</div>

<style is:global>
  .prose {
    margin-inline: auto;
  }
  .prose h2 {
    position: relative;
    padding-block-start: 1rem;
  }
  .prose h2::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 3rem;
    height: 4px;
    background: var(--series, var(--herbal-green));
    border-radius: 2px;
  }
  .prose h3 {
    font-weight: 500;
    color: var(--series, var(--herbal-green));
  }
  .prose h4 {
    font-family: var(--font-body);
    font-size: var(--fs-label);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--brown);
    margin-block-start: var(--space-md);
  }
  .prose strong {
    color: var(--text-strong);
  }
  .prose blockquote {
    margin-inline: 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-inline-start: 4px solid var(--series, var(--earth-gold));
    background: color-mix(in srgb, var(--series, var(--earth-gold)) 8%, var(--rice-paper));
  }
  .prose img {
    display: block;
    margin: var(--space-md) auto;
    border-radius: 4px;
    box-shadow: 0 4px 18px rgba(30, 74, 62, 0.15);
  }
  .prose .bibliography {
    margin-block-start: var(--space-sm);
    padding: var(--space-md);
    background: var(--cream);
    border: 1px solid var(--tan);
    border-radius: var(--radius);
  }
  .prose .bibliography p {
    font-size: 0.9rem;
    line-height: 1.55;
    margin: 0 0 0.85rem;
    padding-inline-start: 1.75rem;
    text-indent: -1.75rem;
    overflow-wrap: anywhere;
  }
  .prose .bibliography p:last-child {
    margin-block-end: 0;
  }
</style>

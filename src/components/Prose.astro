---
---
<div class="prose">
  <slot />
</div>

<style is:global>
  .prose {
    margin-inline: auto;
  }
  .prose h2 {
    position: relative;
    padding-block-start: 1rem;
  }
  .prose h2::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 3rem;
    height: 4px;
    background: var(--herbal-green);
    border-radius: 2px;
  }
  /* One subtitle style for every heading level inside a post: same font,
     size, weight and color. h3/h4 (sub-sections) skip the green rule so the
     hierarchy still reads, but they are never smaller or a different face. */
  .prose h2,
  .prose h3,
  .prose h4 {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 500;
    font-style: normal;
    line-height: var(--lh-display);
    letter-spacing: 0;
    text-transform: none;
    color: var(--text-strong);
  }
  .prose h3,
  .prose h4 {
    margin-block-start: var(--space-md);
  }
  .prose strong {
    color: var(--text-strong);
  }
  .prose blockquote {
    margin-inline: 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-inline-start: 3px solid var(--earth-gold);
    background: var(--jade-wash);
  }
  .prose img {
    display: block;
    margin: var(--space-md) auto;
    border-radius: 4px;
    box-shadow: 0 2px 12px rgba(47, 93, 80, 0.14);
  }
  .prose .bibliography {
    margin-block-start: var(--space-sm);
    padding: var(--space-md);
    background: var(--jade-wash);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .prose .bibliography p {
    font-size: 0.9rem;
    line-height: 1.55;
    margin: 0 0 0.85rem;
    padding-inline-start: 1.75rem;
    text-indent: -1.75rem;
    overflow-wrap: anywhere;
  }
  .prose .bibliography p:last-child {
    margin-block-end: 0;
  }
</style>

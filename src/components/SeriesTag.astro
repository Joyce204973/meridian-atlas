---
import { SERIES } from "../consts";

interface Props {
  series: string;
  linked?: boolean;
}
const { series, linked = true } = Astro.props;
const entry = SERIES.find((s) => s.slug === series);
const name = entry?.name ?? series;
---

{linked ? (
  <a href={`/series/${series}`} class="chip">{name}</a>
) : (
  <span class="chip">{name}</span>
)}

<style>
  .chip {
    display: inline-block;
    background: var(--jade-wash);
    color: var(--herbal-green);
    border: 1px solid var(--soft-jade);
    font-size: var(--fs-tag);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    padding: 0.25em 0.7em;
    border-radius: var(--radius);
    text-decoration: none;
    line-height: 1.4;
  }
  a.chip:hover {
    background: var(--herbal-green);
    color: var(--rice-paper);
  }
</style>

---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { SITE_TAGLINE, HERO_HEADLINE, SERIES } from "../consts";
import { withReadingTime } from "../lib/with-reading-time";

const allPosts = await getCollection("posts", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
);
const recentPosts = [...allPosts]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
const recentWithTimes = await withReadingTime(recentPosts);
const countBySeries = (slug: string) => allPosts.filter((p) => p.data.series === slug).length;
---

<Base>
  <!-- Top of the page only: deep green, like the first slide -->
  <section class="hero">
    <div class="hero-inner">
      <img
        src="/images/globe-mark.png"
        alt="The Meridian Atlas mark: a globe traced with meridian lines"
        width="220"
        height="220"
        class="hero-mark"
      />
      <div class="hero-copy">
        <p class="eyebrow">The Meridian Atlas &middot; {SITE_TAGLINE}</p>
        <h1>{HERO_HEADLINE}</h1>
        <p class="subject-lead">the scientific explanations behind</p>
        <p class="subject">
          <span class="subject-big">Wellness trends</span>
          <span class="subject-and">and</span>
          <span class="subject-big">everyday health problems</span>
        </p>
        <div class="hero-actions">
          <a class="button button--light" href="/blog">Start reading</a>
          <a class="button-outline" href="/about">About Joyce</a>
        </div>
      </div>
    </div>
  </section>

  <!-- The intro paragraph, broken into three clusters -->
  <section class="explainer">
    <div class="explainer-inner">
      <div class="flow">
        <div class="box box-check">
          <p class="small-label">checked against</p>
          <p class="strong-line">peer-reviewed<br />evidence</p>
        </div>

        <svg class="link link-fork" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 50 C50 50 50 22 100 22" />
          <path d="M0 50 C50 50 50 78 100 78" />
        </svg>

        <div class="pair">
          <p class="small-label pair-label">read through two medical systems</p>
          <div class="box box-system"><p class="system">Biomedicine</p></div>
          <div class="box box-system"><p class="system">Chinese medicine</p></div>
        </div>

        <svg class="link link-merge" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 22 C50 22 50 50 100 50" />
          <path d="M0 78 C50 78 50 50 100 50" />
        </svg>

        <div class="box box-atlas">
          <p class="atlas-name">The Meridian Atlas</p>
          <p class="atlas-line">
            holds the <strong>two maps</strong> of human health side by side, showing where they{" "}
            <strong>agree</strong> and where they <strong>disagree</strong>.
          </p>
        </div>
      </div>
    </div>
  </section>

  {recentWithTimes.length > 0 && (
    <section class="recent">
      <div class="recent-inner">
        <h2>Recent essays</h2>
        <div class="recent-grid">
          {recentWithTimes.map(({ post, readingTime }) => (
            <PostCard
              href={`/blog/${post.id}`}
              title={post.data.title}
              description={post.data.description}
              series={post.data.series}
              pubDate={post.data.pubDate}
              readingTime={readingTime}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="series-band">
    <div class="series-grid-section">
      <h2>Explore by series</h2>
      <div class="series-grid">
        {SERIES.map((s) => {
          const n = countBySeries(s.slug);
          return (
            <a class="series-card" href={`/series/${s.slug}`}>
              <span class="count">{n > 0 ? `${n} ${n === 1 ? "essay" : "essays"}` : "Coming soon"}</span>
              <h3>{s.name}</h3>
              <p>{s.blurb}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="quiz-callout">
    <div class="quiz-inner">
      <p class="quiz-label">Self-Assessment</p>
      <h2>Find Your TCM Archetype</h2>
      <p class="quiz-callout-text">
        Five-Phase theory holds that one phase &mdash; Wood, Fire, Earth, Metal, or Water &mdash;
        organizes how a person moves through the world. Answer 30 short statements to
        find yours.
      </p>
      <a class="button" href="/archetype-quiz">Take the Quiz</a>
    </div>
  </section>

  <section id="subscribe" class="subscribe-band">
    <div class="subscribe-section">
      <h2>Join the list</h2>
      <p>New essays, roughly every other week. No noise, no wellness fluff.</p>
      <form class="subscribe-form" action="#" method="post">
        <label class="visually-hidden" for="email">Email address</label>
        <input id="email" name="email" type="email" placeholder="you@example.com" required />
        <button class="button" type="submit">Subscribe</button>
      </form>
      <p class="form-note">Subscription form goes live once a mailing list provider is connected.</p>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero (the only green block, as on the first slide) ---------- */
  .hero {
    background: var(--herbal-green);
    color: var(--rice-paper);
  }
  .hero-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-lg);
    align-items: center;
  }
  .hero-mark {
    display: block;
    width: 14rem;
    height: 14rem;
    border-radius: 50%;
  }
  .eyebrow {
    font-size: var(--fs-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--earth-gold);
    margin: 0 0 var(--space-sm);
  }
  .hero h1 {
    color: var(--rice-paper);
    margin: 0 0 var(--space-sm);
  }
  .subject-lead {
    font-size: var(--fs-lede);
    font-weight: 300;
    color: var(--rice-paper);
    opacity: 0.9;
    margin: 0 0 0.25rem;
  }
  .subject {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--earth-gold);
    margin: 0 0 var(--space-md);
    line-height: 1.25;
  }
  .subject-big {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }
  .subject-and {
    font-size: 1.35rem;
    margin-inline: 0.3em;
    opacity: 0.9;
  }
  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
  .button-outline {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--fs-label);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--rice-paper);
    border: 1px solid var(--rice-paper);
    padding: 0.85em 1.6em;
    border-radius: var(--radius);
    text-decoration: none;
  }
  .button-outline:hover {
    background: var(--rice-paper);
    color: var(--herbal-green);
  }

  /* ---------- Explainer: three clusters, left to right ---------- */
  .explainer {
    background: var(--jade-wash);
    border-block-end: 1px solid var(--rule);
  }
  .explainer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
  }
  .flow {
    display: grid;
    grid-template-columns: 1fr 3.5rem 1fr 3.5rem 1.35fr;
    align-items: stretch;
  }
  .box {
    background: var(--rice-paper);
    border: 1px solid var(--soft-jade);
    border-radius: var(--radius);
    padding: var(--space-md);
  }
  .box-check {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-block-start: 3px solid var(--herbal-green);
  }
  .small-label {
    font-size: var(--fs-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--herbal-green);
    margin: 0 0 0.4rem;
  }
  .strong-line {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.9rem, 3vw, 2.5rem);
    line-height: 1.1;
    color: var(--text-strong);
    margin: 0;
  }
  .link {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--earth-gold);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .link path {
    vector-effect: non-scaling-stroke;
  }
  .pair {
    display: grid;
    grid-template-rows: auto 1fr 1fr;
    gap: var(--space-xs);
  }
  .pair-label {
    margin: 0;
  }
  .box-system {
    display: flex;
    align-items: center;
    padding-block: var(--space-sm);
  }
  .system {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 600;
    color: var(--herbal-green);
    margin: 0;
  }
  .box-atlas {
    background: var(--herbal-green);
    border-color: var(--herbal-green);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .atlas-name {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 600;
    color: var(--rice-paper);
    margin: 0 0 0.4rem;
  }
  .atlas-line {
    font-size: var(--fs-lede);
    font-weight: 300;
    color: var(--rice-paper);
    margin: 0;
  }
  .atlas-line strong {
    font-weight: 700;
    color: var(--earth-gold);
  }

  /* ---------- Recent ---------- */
  .recent-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
  }
  .recent-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 var(--space-md);
    margin-block-start: var(--space-md);
  }

  /* ---------- Series ---------- */
  .series-band {
    background: var(--jade-wash);
    border-block: 1px solid var(--rule);
  }
  .series-grid-section {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
  }
  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr));
    gap: var(--space-sm);
    margin-block-start: var(--space-md);
  }
  .series-card {
    display: block;
    background: var(--rice-paper);
    border: 1px solid var(--soft-jade);
    border-block-start: 3px solid var(--herbal-green);
    border-radius: var(--radius);
    padding: var(--space-md);
    text-decoration: none;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .series-card:hover {
    border-color: var(--jade);
    box-shadow: 0 6px 18px rgba(47, 93, 80, 0.12);
  }
  .count {
    font-size: var(--fs-tag);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--text-muted);
  }
  .series-card h3 {
    font-size: 1.55rem;
    margin: 0.5rem 0;
    color: var(--herbal-green);
  }
  .series-card p {
    color: var(--text);
    margin: 0;
    font-size: var(--fs-small);
  }

  /* ---------- Quiz ---------- */
  .quiz-inner {
    max-width: 40rem;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
    text-align: center;
  }
  .quiz-label {
    font-size: var(--fs-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--herbal-green);
    margin: 0;
  }
  .quiz-callout h2 {
    margin: 0.4rem 0 var(--space-sm);
  }
  .quiz-callout-text {
    color: var(--text);
    max-width: 48ch;
    margin: 0 auto var(--space-md);
  }

  /* ---------- Subscribe ---------- */
  .subscribe-band {
    background: var(--jade-wash);
    border-block-start: 1px solid var(--rule);
  }
  .subscribe-section {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
    text-align: center;
  }
  .subscribe-form {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    max-width: 30rem;
    margin: var(--space-md) auto 0.5rem;
    flex-wrap: wrap;
  }
  .subscribe-form input {
    flex: 1;
    min-width: 12rem;
    padding: 0.85em 1em;
    border: 1px solid var(--soft-jade);
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    background: var(--rice-paper);
    color: var(--text-strong);
  }
  .form-note {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      padding-block: var(--space-lg);
    }
    .hero-mark {
      width: 9rem;
      height: 9rem;
    }
    .flow {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .link {
      height: 2.5rem;
      width: 2px;
      margin-inline: auto;
      stroke: none;
      background: var(--earth-gold);
    }
    .link path {
      display: none;
    }
    .recent-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .series-card { transition: none; }
  }
</style>

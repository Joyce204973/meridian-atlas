---
import Base from "../layouts/Base.astro";
import { PHASES, PHASE_ORDER } from "../data/archetypes";
---

<Base
  title="The Five Archetypes"
  description="Wood, Fire, Earth, Metal, Water — the five archetypes of TCM Five-Phase theory, and what each one sees about the way a person moves through the world."
>
  <div class="archetypes-page">
    <header class="intro">
      <p class="tag">Five-Phase Theory</p>
      <h1>The Five Archetypes</h1>
      <p class="lede">
        TCM's Five-Phase theory holds that one phase — Wood, Fire, Earth, Metal, or
        Water — tends to organize how a person moves through the world: what drives
        them, what depletes them, and what they need when they're out of balance. No
        phase is better than another. Each is a different answer to the same question:
        what does this person need to feel like themselves?
      </p>
    </header>

    <svg class="river-divider" viewBox="0 0 600 40" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 20 C 100 5, 150 35, 250 20 S 400 5, 500 22 S 580 30, 600 18" />
    </svg>

    <div class="archetype-grid">
      {PHASE_ORDER.map((id) => {
        const p = PHASES[id];
        return (
          <a class="archetype-card" href={`/archetypes/${p.slug}`}>
            <p class="card-season">{p.season}</p>
            <h2>{p.phaseName} — {p.archetype}</h2>
            <p class="card-teaser">{p.teaser}</p>
            <span class="learn-more">Learn more &rarr;</span>
          </a>
        );
      })}
    </div>

    <div class="quiz-cta">
      <p>Not sure which one is yours?</p>
      <a class="button" href="/archetype-quiz">Take the Quiz</a>
    </div>

    <p class="source-note">
      Adapted from the Five-Phase framework in Beinfield, H., &amp; Korngold, E. (1991).
      <em>Between Heaven and Earth: A Guide to Chinese Medicine.</em> Ballantine Books.
    </p>
  </div>
</Base>

<style>
  .archetypes-page {
    max-width: 56rem;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md) var(--space-xl);
  }
  .intro {
    max-width: 60ch;
  }
  .intro h1 {
    margin: 0.4rem 0 var(--space-sm);
  }
  .lede {
    font-weight: 300;
    font-size: var(--fs-lede);
    color: var(--text);
  }

  .river-divider {
    display: block;
    width: 100%;
    height: 2.5rem;
    margin-block: var(--space-lg);
  }
  .river-divider path {
    fill: none;
    stroke: var(--soft-jade);
    stroke-width: 1.5;
  }

  .archetype-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-md);
    margin-block-end: var(--space-xl);
  }
  .archetype-card {
    display: block;
    background: var(--bg-alt);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--space-md);
    text-decoration: none;
  }
  .archetype-card:hover {
    border-color: var(--jade);
  }
  .card-season {
    font-family: var(--font-body);
    font-size: var(--fs-tag);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--earth-gold);
    margin: 0 0 0.3rem;
  }
  .archetype-card h2 {
    font-size: 1.4rem;
    margin: 0 0 0.5rem;
    color: var(--herbal-green);
  }
  .card-teaser {
    color: var(--text);
    font-size: var(--fs-small);
    margin: 0 0 var(--space-sm);
  }
  .learn-more {
    font-family: var(--font-body);
    font-size: var(--fs-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--jade);
  }

  .quiz-cta {
    text-align: center;
    padding: var(--space-lg);
    background: var(--bg-alt);
    border-radius: var(--radius);
    margin-block-end: var(--space-lg);
  }
  .quiz-cta p {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--text-strong);
    margin: 0 0 var(--space-sm);
  }

  .source-note {
    color: var(--text-muted);
    font-size: var(--fs-small);
    text-align: center;
  }
</style>

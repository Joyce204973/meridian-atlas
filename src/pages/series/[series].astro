---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { SERIES } from "../../consts";
import { withReadingTime } from "../../lib/with-reading-time";

export async function getStaticPaths() {
  return SERIES.map((s) => ({ params: { series: s.slug }, props: { series: s } }));
}

const { series } = Astro.props;
const posts = await getCollection("posts", ({ data }) =>
  (import.meta.env.PROD ? !data.draft : true) && data.series === series.slug
);
const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const withTimes = await withReadingTime(sorted);
---

<Base title={series.name} description={series.blurb}>
  <div class="band">
    <header>
      <p class="kicker">Series</p>
      <h1>{series.name}</h1>
      <p class="blurb">{series.blurb}</p>
    </header>
  </div>
  <div class="series-page">
    {withTimes.length === 0 ? (
      <p class="empty">Essays for this series are on their way.</p>
    ) : (
      <div class="list">
        {withTimes.map(({ post, readingTime }) => (
          <PostCard
            href={`/blog/${post.id}`}
            title={post.data.title}
            description={post.data.description}
            series={post.data.series}
            pubDate={post.data.pubDate}
            readingTime={readingTime}
          />
        ))}
      </div>
    )}
  </div>
</Base>

<style>
  .band {
    background: var(--herbal-green);
    color: var(--rice-paper);
    padding: var(--space-lg) var(--space-md);
  }
  .band header {
    max-width: 48rem;
    margin: 0 auto;
  }
  .kicker {
    font-size: var(--fs-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    margin: 0;
    color: var(--earth-gold);
  }
  .band h1 {
    color: var(--rice-paper);
    margin: 0.3rem 0 0.6rem;
  }
  .blurb {
    max-width: 60ch;
    margin: 0;
    font-size: var(--fs-lede);
    font-weight: 300;
  }
  .series-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
  }
  .empty {
    color: var(--text-muted);
    background: var(--jade-wash);
    border: 1px dashed var(--soft-jade);
    padding: var(--space-md);
    border-radius: var(--radius);
  }
</style>

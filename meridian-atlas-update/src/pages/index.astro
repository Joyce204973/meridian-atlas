---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { SITE_TAGLINE, HERO_HEADLINE, HERO_SUBHEAD, SERIES } from "../consts";
import { withReadingTime } from "../lib/with-reading-time";

const allPosts = await getCollection("posts", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
);
const recentPosts = [...allPosts]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
const recentWithTimes = await withReadingTime(recentPosts);
const countBySeries = (slug: string) => allPosts.filter((p) => p.data.series === slug).length;

const steps = [
  {
    n: "1",
    title: "What the evidence says",
    text: "The studies, who was in them, and where the results conflict.",
  },
  {
    n: "2",
    title: "What Chinese medicine asks",
    text: "A different question about the same body, in its own terms.",
  },
  {
    n: "3",
    title: "What holding both teaches",
    text: "Where the maps agree, where they disagree, and whether it is worth trying for you.",
  },
];
---

<Base>
  <section class="hero">
    <div class="hero-inner">
      <img
        src="/images/globe-mark.png"
        alt="The Meridian Atlas mark: a globe traced with meridian lines"
        width="220"
        height="220"
        class="hero-mark"
      />
      <div class="hero-copy">
        <p class="eyebrow">The Meridian Atlas &middot; {SITE_TAGLINE}</p>
        <h1>{HERO_HEADLINE}</h1>
        <p class="lede">{HERO_SUBHEAD}</p>
        <div class="hero-actions">
          <a class="button button--gold" href="/blog">Start reading</a>
          <a class="button-outline" href="/about">About Joyce</a>
        </div>
      </div>
    </div>
  </section>

  <section class="how">
    <p class="section-label">How every essay works</p>
    <div class="steps">
      {steps.map((s) => (
        <div class="step">
          <span class="num">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  {recentWithTimes.length > 0 && (
    <section class="recent">
      <div class="recent-inner">
        <h2>Recent essays</h2>
        <div class="recent-grid">
          {recentWithTimes.map(({ post, readingTime }) => (
            <PostCard
              href={`/blog/${post.id}`}
              title={post.data.title}
              description={post.data.description}
              series={post.data.series}
              pubDate={post.data.pubDate}
              readingTime={readingTime}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="series-grid-section">
    <h2>Explore by series</h2>
    <div class="series-grid">
      {SERIES.map((s) => {
        const n = countBySeries(s.slug);
        return (
          <a class="series-card" href={`/series/${s.slug}`} style={`--series: var(--c-${s.slug})`}>
            <span class="count">{n > 0 ? `${n} ${n === 1 ? "essay" : "essays"}` : "Coming soon"}</span>
            <h3>{s.name}</h3>
            <p>{s.blurb}</p>
          </a>
        );
      })}
    </div>
  </section>

  <section class="quiz-callout">
    <div class="quiz-inner">
      <p class="quiz-label">Self-Assessment</p>
      <h2>Find Your TCM Archetype</h2>
      <p class="quiz-callout-text">
        Five-Phase theory holds that one phase &mdash; Wood, Fire, Earth, Metal, or Water &mdash;
        organizes how a person moves through the world. Answer 30 short statements to
        find yours.
      </p>
      <a class="button button--gold" href="/archetype-quiz">Take the Quiz</a>
    </div>
  </section>

  <section id="subscribe" class="subscribe-section">
    <h2>Join the list</h2>
    <p>New essays, roughly every other week. No noise, no wellness fluff.</p>
    <form class="subscribe-form" action="#" method="post">
      <label class="visually-hidden" for="email">Email address</label>
      <input id="email" name="email" type="email" placeholder="you@example.com" required />
      <button class="button" type="submit">Subscribe</button>
    </form>
    <p class="form-note">Subscription form goes live once a mailing list provider is connected.</p>
  </section>
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    background: var(--forest);
    color: var(--rice-paper);
  }
  .hero-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-lg);
    align-items: center;
  }
  .hero-mark {
    display: block;
    width: 13.75rem;
    height: 13.75rem;
    border-radius: 50%;
    box-shadow: 0 0 0 6px rgba(227, 192, 143, 0.35);
  }
  .eyebrow {
    font-size: var(--fs-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--gold-light);
    margin: 0 0 var(--space-sm);
  }
  .hero h1 {
    color: var(--rice-paper);
    margin: 0 0 var(--space-sm);
  }
  .lede {
    font-weight: 300;
    font-size: var(--fs-lede);
    color: var(--rice-paper);
    opacity: 0.92;
    max-width: 54ch;
    margin: 0 0 var(--space-md);
  }
  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
  .button-outline {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--fs-label);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--rice-paper);
    border: 1px solid var(--gold-light);
    padding: 0.85em 1.6em;
    border-radius: var(--radius);
    text-decoration: none;
  }
  .button-outline:hover {
    background: var(--rice-paper);
    color: var(--forest);
  }

  /* ---- How it works ---- */
  .how {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md) var(--space-md);
  }
  .section-label {
    font-size: var(--fs-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--brown);
    margin: 0 0 var(--space-sm);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }
  .step {
    background: var(--cream);
    border: 1px solid var(--tan);
    border-radius: var(--radius);
    padding: var(--space-md);
  }
  .step:nth-child(1) { background: var(--mint); border-color: var(--soft-jade); }
  .step:nth-child(2) { background: var(--sand); }
  .step:nth-child(3) { background: var(--cream); }
  .num {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--herbal-green);
    color: var(--rice-paper);
    font-weight: 600;
    font-size: var(--fs-small);
    margin-block-end: var(--space-xs);
  }
  .step:nth-child(2) .num { background: var(--c-tcm-kitchen); }
  .step:nth-child(3) .num { background: var(--c-womens-health); }
  .step h3 {
    font-size: 1.4rem;
    margin: 0 0 0.4rem;
  }
  .step p {
    margin: 0;
    font-size: var(--fs-small);
  }

  /* ---- Recent ---- */
  .recent {
    background: var(--sand);
    margin-block-start: var(--space-lg);
  }
  .recent-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
  }
  .recent-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 var(--space-md);
    margin-block-start: var(--space-md);
  }

  /* ---- Series ---- */
  .series-grid-section {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
  }
  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr));
    gap: var(--space-sm);
    margin-block-start: var(--space-md);
  }
  .series-card {
    display: block;
    background: var(--series);
    color: #fff;
    border-radius: var(--radius);
    padding: var(--space-md);
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }
  .series-card:hover {
    color: #fff;
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(30, 74, 62, 0.22);
  }
  .count {
    display: inline-block;
    font-size: var(--fs-tag);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    background: rgba(255, 255, 255, 0.2);
    border-radius: var(--radius);
    padding: 0.25em 0.7em;
  }
  .series-card h3 {
    font-size: 1.55rem;
    margin: 0.7rem 0 0.5rem;
    color: #fff;
  }
  .series-card p {
    color: #fff;
    margin: 0;
    font-size: var(--fs-small);
    opacity: 0.95;
  }

  /* ---- Quiz ---- */
  .quiz-callout {
    background: var(--mint);
    border-block: 1px solid var(--soft-jade);
  }
  .quiz-inner {
    max-width: 40rem;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
    text-align: center;
  }
  .quiz-label {
    font-size: var(--fs-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--herbal-green);
    margin: 0;
  }
  .quiz-callout h2 {
    margin: 0.4rem 0 var(--space-sm);
  }
  .quiz-callout-text {
    color: var(--text);
    max-width: 48ch;
    margin: 0 auto var(--space-md);
  }

  /* ---- Subscribe ---- */
  .subscribe-section {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
    text-align: center;
  }
  .subscribe-form {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    max-width: 30rem;
    margin: var(--space-md) auto 0.5rem;
    flex-wrap: wrap;
  }
  .subscribe-form input {
    flex: 1;
    min-width: 12rem;
    padding: 0.85em 1em;
    border: 1px solid var(--tan);
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    background: var(--cream);
    color: var(--text-strong);
  }
  .form-note {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: left;
      padding-block: var(--space-lg);
    }
    .hero-mark {
      width: 9rem;
      height: 9rem;
    }
    .steps,
    .recent-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .series-card { transition: none; }
    .series-card:hover { transform: none; }
  }
</style>

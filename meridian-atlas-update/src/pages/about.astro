---
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import Base from "../layouts/Base.astro";

// Drop the photo at public/images/joyce-portrait.jpg and it appears here
// automatically — no code change needed.
const portraitPath = fileURLToPath(new URL("../../public/images/joyce-portrait.jpg", import.meta.url));
const hasPortrait = existsSync(portraitPath);
---

<Base
  title="About"
  description="Joyce Ma grew up between Western medicine and Traditional Chinese Medicine, studied biology at Minerva University across six cities and four continents, and is learning to read both maps of the body at once."
>
  <article class="about">
    <div class="about-inner">
      {hasPortrait && (
        <img class="portrait" src="/images/joyce-portrait.jpg" alt="Joyce Ma" width="320" height="320" />
      )}
      <div class="about-text">
        <p class="tag">My Story</p>
        <h1>About Joyce</h1>
        <p class="teaser">
          I grew up on the intersection of two medical worlds — Western medicine and the herbal
          remedies of my family's home in San Francisco. I study biology at Minerva University,
          where my degree has taken me to six cities across four continents, exploring each one
          through the lens of Chinese medicine. I'm not a practitioner yet, but I'm learning to
          read two maps of the body at once, and this site is me showing you what I'm seeing.
        </p>
        <a class="button" href="/about/story">Read the Full Story</a>
      </div>
    </div>

    <div class="future-practice">
      <img src="/images/seal-mark.png" alt="" width="40" height="40" />
      <p>
        <strong>Huang Ma Medicine</strong> is a future acupuncture practice I plan to open once
        I'm licensed. The Meridian Atlas comes first.
      </p>
    </div>
  </article>
</Base>

<style>
  .about {
    max-width: 56rem;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
  }
  .about-inner {
    display: flex;
    gap: var(--space-lg);
    align-items: center;
    flex-wrap: wrap;
  }
  .portrait {
    width: 14rem;
    height: 14rem;
    object-fit: cover;
    object-position: center 20%;
    border-radius: var(--radius);
    flex-shrink: 0;
  }
  .about-text {
    flex: 1;
    min-width: 18rem;
  }
  .about-text h1 {
    margin: 0.4rem 0 var(--space-sm);
  }
  .teaser {
    color: var(--text);
    max-width: 60ch;
    margin-block-end: var(--space-md);
  }
  .future-practice {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-block-start: var(--space-xl);
    padding: var(--space-md);
    background: var(--bg-alt);
    border-radius: var(--radius);
  }
  .future-practice img {
    border-radius: 50%;
    flex-shrink: 0;
  }
  .future-practice p {
    margin: 0;
    color: var(--text);
    font-size: var(--fs-small);
  }
</style>
